{
  "scripts": {
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:report": "npx playwright show-report",
    "test:e2e:audit": "npx playwright test tests/e2e/release-audit.spec.ts --workers=1",
    "test:e2e:audit:watch": "npx playwright test tests/e2e/release-audit.spec.ts --headed --project=desktop-chromium --workers=1",
    "visual:dashboard": "npx playwright test tests/e2e/visual/dashboard.visual.spec.ts --workers=1",
    "visual:dashboard:golden": "node scripts/capture_dashboard_golden.cjs && python scripts/compare_golden_dashboard.py",
    "visual:ui": "npx playwright test tests/e2e/visual/ui.visual.spec.ts --workers=1",
    "visual:all": "npx playwright test tests/e2e/visual --workers=1",
    "visual:auth": "node scripts/create_visual_storage_state.cjs"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "lucide-react": "^0.561.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
