FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/boostudy-python-sandbox
RUN pip install --no-cache-dir docker==7.1.0
COPY app/tasks/python_sandbox_service.py ./python_sandbox_service.py
COPY app/tasks/python_sandbox_entry.py ./python_sandbox_entry.py
CMD ["python", "-I", "/opt/boostudy-python-sandbox/python_sandbox_service.py"]
