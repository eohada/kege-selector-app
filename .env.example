# ==============================================================================
# BooStudy Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Основные параметры платформы
# ------------------------------------------------------------------------------
SECRET_KEY=change-this-in-staging-or-production
# Runtime (use local for development; production values are shown below)
ENVIRONMENT=production
FLASK_ENV=production
APP_URL=https://boostudy.ru
BASE_URL=https://boostudy.ru

# Main Telegram bot
MAIN_BOT_TOKEN=
BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
BOT_INTERNAL_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MAIN_WEBHOOK_SECRET=
TELEGRAM_QA_WEBHOOK_SECRET=
TELEGRAM_POLLING_DROP_PENDING_UPDATES=false

# Optional QA bot
QA_BOT_TOKEN=
TELEGRAM_TESTERS_BOT_TOKEN=
TELEGRAM_QA_POLLING_DROP_PENDING_UPDATES=false

# Application services
DATABASE_URL=postgresql://user:password@localhost:5432/boostudy
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
TELEGRAM_ADMIN_CHAT_ID=

# ------------------------------------------------------------------------------
# 2. ИИ-предпроверка домашних работ (Homework AI Pre-Review)
# ------------------------------------------------------------------------------
# Глобальный флаг включения предпроверки (true/false)
AI_REVIEW_ENABLED=true

# Основной провайдер: для первого пилота строго 'gemini'
AI_REVIEW_PRIMARY_PROVIDER=gemini

# Резервный провайдер: для первого пилота оставляем пустым
AI_REVIEW_FALLBACK_PROVIDER=

# Google Gemini Developer API (Google AI Studio)
# Получите бесплатный API ключ в консоли Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# ВНИМАНИЕ: выберите актуальный ID текстовой модели с доступным Free Tier
# прямо из каталога вашего личного кабинета Google AI Studio (например, актуальную flash/pro модель).
# Не используйте устаревшие линейки gemini-1.5-flash.
GEMINI_MODEL=

# OpenRouter API (для первого пилота не используется, подключается на 2-м этапе)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Сетевой таймаут одного запроса к провайдеру в миллисекундах
AI_REVIEW_TIMEOUT_MS=25000

# ------------------------------------------------------------------------------
# 3. Локальная лаборатория AI Homework (отдельно от рабочих домашних заданий)
# ------------------------------------------------------------------------------
# Для реальных запросов требуется ENVIRONMENT=local/development/dev и флаг true.
# В staging, sandbox и production сервер блокирует вызовы независимо от значения флага.
AI_LAB_ENABLED=false
# Локальные ограничения исследовательской лаборатории.
AI_LAB_RUNS_PER_ADMIN_PER_HOUR=120
AI_LAB_RUNS_PER_HOUR=300
AI_LAB_MAX_INPUT_BYTES=131072
AI_LAB_GIGACHAT_CONCURRENCY=1
AI_LAB_PROVIDER_READ_TIMEOUT_SECONDS=120
AI_LAB_MAX_QUEUE_SIZE=20
AI_LAB_MAX_COMPLETION_TOKENS=1600
# Локальная оценка расходов AI Lab: задайте оба тарифа за 1 млн токенов в своей валюте.
# AI_LAB_GIGACHAT_INPUT_PRICE_PER_MILLION=
# AI_LAB_GIGACHAT_OUTPUT_PRICE_PER_MILLION=
AI_LAB_QUEUE_WAIT_SECONDS=600
# Code Judge is local-only. Start its Docker runner separately; it listens only on loopback.
AI_LAB_CODE_JUDGE_RUNNER_URL=http://127.0.0.1:8778
AI_LAB_CODE_JUDGE_RUNNER_HOST=127.0.0.1
AI_LAB_CODE_JUDGE_RUNNER_TOKEN=replace-with-a-random-local-secret
AI_LAB_CODE_JUDGE_RUNNER_PORT=8778
AI_LAB_CODE_JUDGE_RUNNER_TOKEN=
AI_LAB_CODE_JUDGE_MAX_SOURCE_BYTES=65536
AI_LAB_CODE_JUDGE_MAX_TEST_SET_BYTES=131072
AI_LAB_CODE_JUDGE_MAX_TEST_CASES=30
AI_LAB_CODE_JUDGE_TEST_TIMEOUT_SECONDS=2
AI_LAB_CODE_JUDGE_MEMORY_MB=128
AI_LAB_CODE_JUDGE_CPU_CORES=1
AI_LAB_CODE_JUDGE_MAX_OUTPUT_BYTES=65536
AI_LAB_CODE_JUDGE_PIDS_LIMIT=32
AI_LAB_CODE_JUDGE_CONCURRENCY=1
AI_LAB_CODE_JUDGE_MAX_QUEUE_SIZE=20
AI_LAB_CODE_JUDGE_QUEUE_WAIT_SECONDS=120
# Ключ авторизации GigaChat API храните только в локальном серверном окружении.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель выбирается из фактического каталога, доступного этому ключу.
GIGACHAT_MODEL=
# Если Python не доверяет сертификату GigaChat, укажите путь к PEM bundle с корневым сертификатом НУЦ Минцифры.
# Инструкция и официальный сертификат: https://developers.sber.ru/docs/ru/gigachat/certificates
# Этот параметр также поддерживает совместимое с SDK имя переменной; путь разрешается относительно корня проекта.
GIGACHAT_CA_BUNDLE_FILE=
# Проверка TLS остаётся включённой; не используйте verify=False.
GIGACHAT_CA_BUNDLE=
