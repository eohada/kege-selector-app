# ==============================================================================
# BooStudy Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Основные параметры платформы
# ------------------------------------------------------------------------------
SECRET_KEY=change-this-in-staging-or-production
# Runtime (use local for development; production values are shown below)
ENVIRONMENT=production
FLASK_ENV=production
APP_URL=https://boostudy.ru
BASE_URL=https://boostudy.ru

# Main Telegram bot
MAIN_BOT_TOKEN=
BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
BOT_INTERNAL_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MAIN_WEBHOOK_SECRET=
TELEGRAM_QA_WEBHOOK_SECRET=
TELEGRAM_POLLING_DROP_PENDING_UPDATES=false

# Optional QA bot
QA_BOT_TOKEN=
TELEGRAM_TESTERS_BOT_TOKEN=
TELEGRAM_QA_POLLING_DROP_PENDING_UPDATES=false

# Application services
DATABASE_URL=postgresql://user:password@localhost:5432/boostudy
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
TELEGRAM_ADMIN_CHAT_ID=

# ------------------------------------------------------------------------------
# 2. ИИ-предпроверка домашних работ (Homework AI Pre-Review)
# ------------------------------------------------------------------------------
# Глобальный флаг включения предпроверки (true/false)
AI_REVIEW_ENABLED=true

# Основной провайдер: для первого пилота строго 'gemini'
AI_REVIEW_PRIMARY_PROVIDER=gemini

# Резервный провайдер: для первого пилота оставляем пустым
AI_REVIEW_FALLBACK_PROVIDER=

# Google Gemini Developer API (Google AI Studio)
# Получите бесплатный API ключ в консоли Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# ВНИМАНИЕ: выберите актуальный ID текстовой модели с доступным Free Tier
# прямо из каталога вашего личного кабинета Google AI Studio (например, актуальную flash/pro модель).
# Не используйте устаревшие линейки gemini-1.5-flash.
GEMINI_MODEL=

# OpenRouter API (для первого пилота не используется, подключается на 2-м этапе)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Сетевой таймаут одного запроса к провайдеру в миллисекундах
AI_REVIEW_TIMEOUT_MS=25000
