# =============================================================================
# Переменные окружения платформы КЕГЭ
# Скопируйте этот файл как .env и заполните значения
# =============================================================================

# --- Окружение ---
ENVIRONMENT=local                        # local | development | sandbox | production
IS_SANDBOX=False                         # True для песочницы

# --- Безопасность ---
SECRET_KEY=                              # ОБЯЗАТЕЛЬНО в production! Случайная строка >= 32 символов

# --- База данных ---
DATABASE_URL=                            # postgresql://user:pass@host:port/dbname
DATABASE_EXTERNAL_URL=                   # Внешний URL БД (если отличается от DATABASE_URL)
POSTGRES_URL=                            # Альтернатива DATABASE_EXTERNAL_URL

# --- Redis / live state / Celery ---
REDIS_URL=redis://redis:6379/0           # Live workspace snapshot и Socket.IO/cache
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Административные токены ---
PRODUCTION_ADMIN_TOKEN=                  # Токен для remote admin API (production)
SANDBOX_ADMIN_TOKEN=                     # Токен для remote admin API (sandbox)
ADMIN_ADMIN_TOKEN=                       # Токен для admin-сервера
CROSS_ENV_LOGIN_SECRET=                  # Секрет для кросс-среды автовхода (HMAC)

# --- Тренажёр ---
TRAINER_URL=                             # URL тренажёра (например, https://trainer.example.com)
TRAINER_SHARED_SECRET=                   # Общий секрет для API тренажёра

# --- AI / LLM ---
GIGACHAT_CREDENTIALS=                    # Credentials для GigaChat API

# --- Telegram-бот ---
BOT_INTERNAL_TOKEN=                      # Внутренний токен для API связи с ботом
TELEGRAM_PROXY_URL=                      # Прокси для исходящих запросов Telegram, например http://user:pass@ip:port
BOOTSTRAP_CREATOR_CHAT_ID=               # Резервный chat_id создателя для автономного режима бота
BOOTSTRAP_CREATOR_USERNAME=              # Резервный username создателя без @, например eohada
BOOTSTRAP_CREATOR_DISPLAY_NAME=          # Имя создателя для автопривязки в Telegram

# --- Miro интеграция ---
MIRO_ACCESS_TOKEN=
MIRO_CLIENT_ID=
MIRO_CLIENT_SECRET=
MIRO_REDIRECT_URI=                       # например https://boostudy.ru/auth/miro/callback

# --- Видеоконференции (Daily.co) ---
DAILY_API_KEY=

# --- Загрузки ---
AVATAR_UPLOAD_ROOT=                      # Путь к папке аватаров (по умолчанию: uploads/avatars)
COVER_UPLOAD_ROOT=                       # Путь к папке обложек
THEORY_UPLOAD_ROOT=                      # Путь к папке файлов теории (фото/PDF/вложения), чтобы не терялись после деплоя
TASK_ATTACHMENTS_ROOT=                   # Путь к папке вложений заданий
ANSWER_ATTACHMENTS_ROOT=                 # Путь к папке вложений ответов

# --- URL-адреса сред ---
ADMIN_URL=                               # URL админ-панели
PROD_URL=                                # URL production (для переключателя Прод/Песочница)
SANDBOX_URL=                             # URL песочницы

# --- Режим техработ ---
MAINTENANCE_ENABLED=                     # true/false — принудительно включить техработы
PRODUCTION_URL=                          # URL продакшена для проверки статуса техработ (sandbox)

# --- Сервер ---
PORT=5000                                # Порт приложения
